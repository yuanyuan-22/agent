SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 可选：DeepSeek 原生（llm.provider=deepseek 时用）
DEEPSEEK_API_KEY=

# Pexels 授权素材（可留空，空时只使用本地素材和卡片回退）
PEXELS_API_KEY=
PEXELS_ENABLED=1

# 生成模型（默认复用 SiliconFlow Key）
GENERATION_ENABLED=1
GENERATION_FIRST=0
VIDEO_GENERATION_ENABLED=0
IMAGE_MODEL=Qwen/Qwen-Image
IMAGE_FALLBACK_MODEL=Tongyi-MAI/Z-Image-Turbo
VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B
GENERATION_RETRIES=2
GENERATION_TIMEOUT=120
IMAGE_ENDPOINT=/images/generations
VIDEO_SUBMIT_ENDPOINT=/video/submit
VIDEO_STATUS_ENDPOINT=/video/status
IMAGE_SIZE=768x1344

# 可选：定时回流（0/1 + 间隔分钟）
SCHEDULER_ENABLED=0
SCHEDULER_INTERVAL_MINUTES=60
